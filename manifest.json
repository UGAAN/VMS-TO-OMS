{
  "manifest_version": 3,
  "name": "VMS-Sync: Auto OMS Pickup",
  "short_name": "VMS-Sync",
  "version": "1.0.2",
  "description": "Auto sync scanned Flipkart VMS orders to EliteSecom OMS pickup entry with zero disturbance",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "VMS-Sync Control Panel"
  },
  "permissions": [
    "storage",
    "cookies",
    "declarativeNetRequest",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://fkvms.synlabs.io/*",
    "https://my.elitesecom.ai/*",
    "https://oms.elitesecom.ai/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fkvms.synlabs.io/*"
      ],
      "js": [
        "interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://fkvms.synlabs.io/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://my.elitesecom.ai/*",
        "https://oms.elitesecom.ai/*"
      ],
      "js": [
        "elite_content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
